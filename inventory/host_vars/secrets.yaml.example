# Copy to inventory/host_vars/<host>/secrets.yaml, it is ignored by git.
# Encrypt it too with: ansible-vault encrypt inventory/host_vars/<host>/secrets.yaml
# (uses ~/.ansible_vault_pass from ansible.cfg, ansible decrypts it on its own).

ansible_host: 192.168.1.10

# SSH password, leave out when logging in with an SSH key.
# ansible_password: "..."

# sudo password for become. Same name as in group_vars/all/vault.yaml so
# this one overrides it for this host.
# ansible_become_pass: "..."
